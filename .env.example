# Copia este fichero a .env y rellena los valores. El .env NO se versiona (está en .gitignore).

# --- Proveedor de LLM ---
# "Groq" (nube, por defecto), "Nvidia", "EIO" (servidor de EIO) o "Local" (LM Studio / Ollama).
LLM_PROVIDER=Groq

# Clave de API de Groq (obligatoria si LLM_PROVIDER=Groq; gratuita en https://console.groq.com)
GROQ_API_KEY=gsk_tu_clave_de_groq

# Clave del servidor LLM de EIO (obligatoria si LLM_PROVIDER=EIO).
# URL del servidor LLM de EIO (p. ej. http://HOST:PUERTO/v1). No se versiona: el repo es público.
EIO_BASE_URL=
EIO_API_KEY=

# Solo si LLM_PROVIDER=Local: URL y modelo del servidor LLM.
# - Si el servidor corre en el MISMO PC que Docker: usa host.docker.internal (ya por defecto).
# - Si corre en otra máquina de la red: pon su IP, p. ej. http://192.168.1.64:1234/v1
LLM_LOCAL_BASEURL=http://host.docker.internal:1234/v1
LLM_LOCAL_MODEL=qwen/qwen2.5-vl-7b

# Prueba de grounding ("D'on surt cada dada" al detalle de la factura). false por defecto: añade carga y de momento no aporta.
GROUNDING_HABILITADO=false

# Contraseña del SA de SQL Server (mínimo 8 caracteres con mayúscula, minúscula, dígito y símbolo)
MSSQL_SA_PASSWORD=DocFlow_Dev123!

# Ruta al repositorio del frontend para construir su imagen.
# Por defecto asume que está clonado como hermano: ../Frontend_ClasificadorExtractorDocumentos
# En esta máquina de desarrollo, el frontend está en repos_vscode:
# FRONTEND_PATH=../../repos_vscode/ClassificadorExtractorDocumentos
FRONTEND_PATH=../Frontend_ClasificadorExtractorDocumentos

# --- Solo docker-compose.deploy.yml: HTTPS ---
# Nombre con el que los usuarios acceden (debe coincidir con el CN/SAN del certificado).
APP_DOMAIN=docflow.example.com
# Carpeta del SERVIDOR (ruta absoluta) con server.crt y server.key (PEM).
CERTS_PATH=/opt/docflow/certs
